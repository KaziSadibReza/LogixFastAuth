{
  "name": "smart-login-registration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.admin.config.ts",
    "postbuild": "node -e \"const fs=require('fs');const p='assets/dist/manifest.json';console.log(fs.existsSync(p)?'manifest.json generated at assets/dist/manifest.json':'WARN: manifest.json missing — run npm run build');\"",
    "preview": "vite preview",
    "sync:production": "node scripts/sync-production.mjs",
    "publish:production": "node scripts/sync-production.mjs --push"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^11.0.0",
    "libphonenumber-js": "^1.11.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-phone-number-input": "^3.4.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
